{
  "name": "@daniellevy/assistant-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Shared tool contract for the suite assistant: tool definitions, confirm tokens, Next.js routes and a conformance runner.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance-entry.d.ts",
      "default": "./dist/conformance-entry.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0",
    "zod": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  }
}
